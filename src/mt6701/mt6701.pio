;
; MT6701 SSI: 24-bit, CLK idle high.
; Data updates on rising, sample on falling.
; First falling after CSN is dummy (no sample).
; Last bit: no falling edge; wait one CLK period then sample while high.
; SET = CSN, SIDESET = CLK, IN = DO
;

.program mt6701_ssi
.side_set 1

.wrap_target
    pull block          side 1
    set pins, 0         side 1 [15] ; CSN low, CLK high (>=100ns)
    nop                 side 1 [15]
    nop                 side 0 [7]  ; first falling: no sample
    set x, 22           side 0      ; 23 bits sampled on falling
bitloop:
    nop                 side 1 [7]  ; rising — DO updates
    in pins, 1          side 0 [7]  ; falling — sample
    jmp x-- bitloop     side 0
    nop                 side 1 [7]  ; last rising — CRC LSB
    nop                 side 1 [7]  ; wait one CLK, stay high
    in pins, 1          side 1 [7]  ; sample last bit, CLK high
    set pins, 1         side 1 [15] ; CSN high, CLK idle high
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

static inline void mt6701_ssi_program_init(PIO pio, uint sm, uint offset, uint pin_csn, uint pin_clk, uint pin_do) {
    pio_gpio_init(pio, pin_csn);
    pio_gpio_init(pio, pin_clk);
    pio_gpio_init(pio, pin_do);
    gpio_disable_pulls(pin_do);
    gpio_pull_up(pin_do);

    pio_sm_set_consecutive_pindirs(pio, sm, pin_csn, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_clk, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_do, 1, false);

    pio_sm_config c = mt6701_ssi_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin_csn, 1);
    sm_config_set_sideset_pins(&c, pin_clk);
    sm_config_set_in_pins(&c, pin_do);
    sm_config_set_in_shift(&c, false, true, 24);
    // PIO ~2 MHz; half-bit 8 cycles → CLK ~125 kHz (period >> 64ns)
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / 2000000.0f);

    pio_sm_set_pins_with_mask(pio, sm, (1u << pin_csn) | (1u << pin_clk), (1u << pin_csn) | (1u << pin_clk));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
